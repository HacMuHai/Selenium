# Sao chép file này thành `.env` rồi điền giá trị thật. `.env` đã được gitignore.

# --- MongoDB (BẮT BUỘC) ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGO_DB=selenium_scraper
# Tên collection lịch sử là "comments" nhưng mỗi document là 1 product.
MONGO_COLLECTION=comments

# --- Logging ---
LOG_LEVEL=INFO

# --- Selenium ---
HEADLESS=true
MAX_WORKERS=3
WAIT_TIMEOUT=15

# --- Export Excel ---
EXPORT_DIR=excel_comment
MAX_ROWS_PER_FILE=2000

# --- Phân tích cảm xúc ---
MODELS_DIR=models_store
TAG_DIR=excel_tag_v2
DEFAULT_MODEL=svm
TEST_SIZE=0.2
RANDOM_SEED=42
